#!/usr/bin/env python3
import argparse
import os
import sys
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), 'src'))
from kirlib import parse_program, load_machine, KirError
from selection import select

def main():
    parser = argparse.ArgumentParser(description='Optimize a Kiln KIR program')
    parser.add_argument('input')
    parser.add_argument('--machine', required=True)
    parser.add_argument('--profile')
    parser.add_argument('-o', required=True, dest='output')
    args = parser.parse_args()
    try:
        with open(args.input, encoding='utf-8') as f: source = f.read()
        machine = load_machine(args.machine)
        profile = []
        if args.profile:
            with open(args.profile, encoding='utf-8') as f:
                for line in f:
                    fields = line.split('#', 1)[0].split()
                    if len(fields) == 4 and fields[0] == 'edge' and fields[3].isascii() and fields[3].isdigit() and len(fields[3]) <= 18:
                        profile.append((fields[1], fields[2], int(fields[3])))
        prog = parse_program(source)
        output = select(prog, machine, profile, source)
        if output is None:
            raise KirError('input uses a fused instruction unavailable on the selected machine')
        with open(args.output, 'w', encoding='utf-8', newline='\n') as f: f.write(output)
    except (OSError, UnicodeError, KirError) as e:
        print('kopt: %s' % e, file=sys.stderr)
        return 1
    return 0
if __name__ == '__main__': sys.exit(main())
